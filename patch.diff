 from ebooklib.utils import guess_type
 
 
+class _ItemList(list):
+    """List of book items that maintains an ``id -> first item`` index.
+
+    ``get_item_with_id`` used to scan every item on each call, which made building
+    a book quadratic in the number of items. Appends update the index in O(1);
+    anything that can reorder or drop items only marks it dirty and the next lookup
+    rebuilds, so the index never goes stale even if callers mutate ``book.items``
+    directly.
+    """
+
+    __slots__ = ("_index", "_dirty")
+
+    def __init__(self, iterable=()):
+        super().__init__(iterable)
+        self._index = {}
+        self._dirty = True
+
+    def _rebuild(self):
+        self._index = {}
+        for item in self:
+            self._index.setdefault(item.id, item)  # first item wins, like the scan
+        self._dirty = False
+
+    def lookup(self, uid):
+        if not self._dirty:
+            item = self._index.get(uid)
+            # item.id may have been reassigned since the index was built
+            if item is not None and item.id == uid:
+                return item
+        self._rebuild()
+        return self._index.get(uid)
+
+    def __reduce_ex__(self, protocol):
+        # rebuild through __init__ so unpickling does not append into a
+        # half-initialised instance (list subclasses replay APPEND before state)
+        return (self.__class__, (list(self),))
+
+    def append(self, item):
+        super().append(item)
+        if not self._dirty:
+            self._index.setdefault(item.id, item)
+
+    def extend(self, items):
+        items = list(items)
+        super().extend(items)
+        if not self._dirty:
+            for item in items:
+                self._index.setdefault(item.id, item)
+
+    def __iadd__(self, items):
+        self.extend(items)
+        return self
+
+
+def _invalidating(name):
+    original = getattr(list, name)
+
+    def mutate(self, *args, **kwargs):
+        result = original(self, *args, **kwargs)
+        self._dirty = True
+        return result
+
+    return mutate
+
+
+# insert/delete/reorder can change which item is "first" for an id
+for _name in ("insert", "__setitem__", "__delitem__", "pop", "remove", "clear", "sort", "reverse", "__imul__"):
+    setattr(_ItemList, _name, _invalidating(_name))
+
+
